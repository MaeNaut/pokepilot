{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qa-pokepilot",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "POKEPILOT_ANALYSIS_GATE", "class_name": "PokePilotAnalysisGate", "script_name": "pokepilot" }]
  },
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pokepilot-qa",
      "database_id": "da0ec6fe-b092-4533-8f49-7a3575f7f451",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "GOOGLE_OAUTH_REDIRECT_URI": "https://qa-pokepilot.pokepilot-ai.workers.dev/api/auth/google/callback",
    "POKEPILOT_METRICS_ENABLED": "true",
    "POKEPILOT_USAGE_METRICS_ENABLED": "false",
    "POKEPILOT_AUTH_REQUIRED": "true",
    "POKEPILOT_ANALYSIS_GATE_SCOPE": "qa",
    "POKEPILOT_ANALYSIS_PAUSED": "false"
  }
}
