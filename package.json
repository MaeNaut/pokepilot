{
  "name": "pokepilot-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:shared": "vite --mode shared --host 127.0.0.1 --port 5198 --strictPort",
    "dev:ai": "vite --mode ai-test",
    "dev:ai:fresh": "vite --mode ai-fresh",
    "dev:cooldown": "vite --mode cooldown-test",
    "data:locales": "node scripts/generate-pokeapi-locales.mjs",
    "data:showdown": "node scripts/generate-showdown-catalogs.mjs",
    "eval:ai": "tsx scripts/run-ai-evaluation.ts",
    "verify:deployment": "tsx scripts/verify-deployment-safeguards.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "audit:all": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm run test:run && npm run build"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.3.0",
    "@fortawesome/react-fontawesome": "^3.4.0",
    "@smogon/calc": "^0.11.0",
    "@upstash/redis": "^1.38.1",
    "@vitejs/plugin-react": "^4.3.4",
    "html-to-image": "^1.11.13",
    "openai": "^7.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "acorn": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "tsx": "^4.23.1",
    "typescript-eslint": "^8.18.2",
    "vitest": "^4.1.10"
  }
}
