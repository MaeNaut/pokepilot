# Used by the local evaluation CLI and the Vite development-only server route.
# Production must set this as a server-side deployment secret, never a VITE_* variable.
OPENAI_API_KEY=

# Recommended in production for signing anonymous rate-limit cookies and hashing IPs.
# Use a separate random server secret; never expose it through a VITE_* variable.
POKEPILOT_CLIENT_SECRET=

# Keep Upstash credentials out of this base local file so routine `npm run dev`
# continues to use process-local memory. See `.env.shared.example` for the
# opt-in shared-store development mode and deployment variables.
