# Used by the Vite development-only server route.
# Public Worker analysis uses each account's encrypted personal key instead.
OPENAI_API_KEY=

# Required by evaluation CLIs; never falls back to OPENAI_API_KEY.
OPENAI_EVALUATION_API_KEY=

# Recommended in production for signing anonymous rate-limit cookies and hashing IPs.
# Use a separate random server secret; never expose it through a VITE_* variable.
POKEPILOT_CLIENT_SECRET=

# Vite uses process-local memory. Cloudflare request/capacity protection uses
# the POKEPILOT_ANALYSIS_GATE binding, not external database credentials.
