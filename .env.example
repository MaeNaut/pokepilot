# Used by the local evaluation CLI and the Vite development-only server route.
# Production must set this as a server-side deployment secret, never a VITE_* variable.
OPENAI_API_KEY=

# Recommended in production for signing anonymous rate-limit cookies and hashing IPs.
# Use a separate random server secret; never expose it through a VITE_* variable.
POKEPILOT_CLIENT_SECRET=

# Optional shared operational storage for multi-instance deployment.
# Configure both credentials as server-side secrets. Keep REQUIRED=true on a
# public deployment so a missing Redis binding fails closed instead of silently
# falling back to per-instance memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
POKEPILOT_REDIS_PREFIX=pokepilot:operations:v1
POKEPILOT_SHARED_STORE_REQUIRED=false
