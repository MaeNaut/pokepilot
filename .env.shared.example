# Copy this file to `.env.shared.local`, then enter the REST credentials from
# the Upstash console. Vite loads it only for `npm run dev:shared`.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Keep development, preview, and production data in distinct namespaces even
# if they temporarily share one Redis database.
POKEPILOT_REDIS_PREFIX=pokepilot:operations:dev

# `dev:shared` also enforces this in code. Keep it true in public deployments
# so missing Redis credentials fail closed instead of using per-instance memory.
POKEPILOT_SHARED_STORE_REQUIRED=true
